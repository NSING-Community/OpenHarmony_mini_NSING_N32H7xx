# Sample application for the N32H7xx EVAL board.
#
# The build system links every component listed in bundle.json's sub_component
# with -Wl,--whole-archive, so the SYS_RUN() entry registered from app_main.c
# always reaches the final image even though nothing references it directly.
#
# Uses kernel_module() like the board package does, so the sources get the same
# toolchain settings (-mcpu/-mfpu hard-float, -nostdlib, -imacros config.h).

import("//kernel/liteos_m/liteos.gni")

module_name = "n32h7xx_sample_app"

# Demo tasks (LED blinker, heartbeat, I2C EEPROM, PWM sweep, ADC temperature).
# Build XTS images with app_demo=false so the test firmware contains only the
# test framework and no application tasks competing for CPU or RAM.
declare_args() {
  app_demo = true
}

kernel_module(module_name) {
  sources = [
    "src/app_main.c",
  ]

  include_dirs = [
    # ohos_init.h (SYS_RUN) and the lite utils headers
    "//commonlibrary/utils_lite/include",
    "//utils/native/lite/include",
    # cmsis_os2.h (osThreadNew / osDelay / osKernelGetTickFreq)
    "//kernel/liteos_m/kal/cmsis",
    # board_led.h - the board wiring (LED pin numbers, active level)
    "//device/board/Nsing/n32h7xx_eval/liteos_m/board/include",
  ]

  # gpio_if.h / uart_if.h live in the HDF framework; this config brings in every
  # include path the HDF interfaces need (framework/include*, interfaces/inner_api*,
  # khdf osal headers, ...). Same config the board package uses.
  configs += [ "//drivers/hdf_core/adapter/khdf/liteos_m:hdf_config" ]

  if (app_demo) {
    cflags = [ "-Wno-error", "-DAPP_DEMO_TASKS=1" ]
  } else {
    cflags = [ "-Wno-error", "-DAPP_DEMO_TASKS=0" ]
  }
}
