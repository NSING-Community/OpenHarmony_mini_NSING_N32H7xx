# N32H7xx EVAL LiteOS-M (mini) kernel defconfig.
# This file is the LOSCFG_* configuration consumed by the liteos_m build
# (it becomes target_config.h / config.h). The build wires board/soc via
# LOSCFG_SOC_COMPANY -> //device/soc/Nsing.

# --- Board / SoC selection (pins the build-graph path) ---
LOSCFG_SOC_COMPANY="Nsing"
LOSCFG_SOC_SERIES="n32h7xx"
LOSCFG_SOC="n32h7xx"

# --- Arch ---
LOSCFG_ARCH_ARM=y
LOSCFG_ARCH_CORTEX_M7=y
LOSCFG_ARCH_FPU_VFP_D16=y

# hwiForm (RAM vector table repointed by HalHwiInit) must be aligned to >= the
# table size rounded up to a power of two. N32H7 has ~406 vectors (1624 bytes)
# -> 2048-byte alignment required for VTOR.
LOSCFG_ARCH_HWI_VECTOR_ALIGN=2048

# --- Tick ---
# Mini uses LOSCFG_BASE_CORE_TICK_PER_SECOND_MINI (=100) for the tick rate.
LOSCFG_BASE_CORE_TICK_PER_SECOND=100
LOSCFG_BASE_CORE_TICK_PER_SECOND_MINI=100

# --- SMP off (CM7 single-core target) ---
LOSCFG_KERNEL_SMP=n
LOSCFG_KERNEL_SMP_CPU_NUM=1

# --- No interactive shell in mini ---
LOSCFG_SHELL=n

# --- Toolchain ---
LOSCFG_COMPILER_GCC=y

# --- Keep the kernel lean for first bring-up (enable later as needed) ---
LOSCFG_KERNEL_TEST=n
LOSCFG_KERNEL_BACKTRACE=n
LOSCFG_KERNEL_PM=y

# --- HDF driver framework (M5: GPIO + UART only) ---
# Enabled so DeviceManagerStart() can bring up the HDF device tree.
# NOTE: DRIVERS_HDF selects KERNEL_PM, so LOSCFG_KERNEL_PM must be y (not n).
LOSCFG_DRIVERS_HDF=y
LOSCFG_DRIVERS_HDF_PLATFORM=y
LOSCFG_DRIVERS_HDF_PLATFORM_GPIO=y
LOSCFG_DRIVERS_HDF_PLATFORM_UART=y
LOSCFG_DRIVERS_HDF_PLATFORM_I2C=y
LOSCFG_DRIVERS_HDF_PLATFORM_PWM=y

# --- SoC company bool: required by drivers/hdf_core/adapter/platform/*/BUILD.gn ---
LOSCFG_SOC_COMPANY_NSING=y
